// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ===== 多租戶 =====
model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  plan            String   @default("freemium") // freemium | starter | growth | agency
  status          String   @default("active")

  // Credit system
  creditBalance         Int      @default(100)
  monthlyCreditAllowance Int      @default(100)
  billingCycleResetDate DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  leads           Lead[]
  campaigns       Campaign[]
  emailConfig     EmailConfig?
  serviceOffering ServiceOffering?
  emailEvents     EmailEvent[]
  meetings        Meeting[]
  usageEvents     UsageEvent[]
  creditLogs      CreditLog[]
  mailboxes       Mailbox[]
}

// ===== 使用者與權限 =====
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String   // bcrypt hash
  role          String   @default("sdr") // admin | sales_manager | sdr
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]   @relation("AssignedLeads")  // SDR 被分配的 leads
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([role])
}

// ===== 潛在客戶名單 =====
model Lead {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assigneeId    String?  // 被分配給哪個 SDR
  assignee      User?    @relation("AssignedLeads", fields: [assigneeId], references: [id], onDelete: SetNull)

  company       String
  contactName   String?
  title         String?
  email         String?
  linkedinUrl   String?
  website       String?
  industry      String?
  companySize   String?
  location      String?

  // AI 產出欄位
  painPoints    String?
  hiringSignals String?
  icebreaker    String?
  emailSubject  String?
  emailBody     String?
  researchRaw   String?

  // 深度研究
  deepResearch  String?
  researchMode  String   @default("basic")
  researchSources String?

  // Email Enrichment
  enrichedEmails String?

  // 流程控制
  status        String   @default("new")
  score         Int?
  tags          String?

  // Email tracking
  openedAt      DateTime?
  clickedAt     DateTime?
  bouncedAt     DateTime?
  bouncedReason String?
  isBlocklisted Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  emailEvents   EmailEvent[]
  meetings      Meeting[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([status])
  @@index([company])
}

model Campaign {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  subject     String
  body        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// ===== 設定（每個租戶一筆） =====
model EmailConfig {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // SMTP
  smtpHost          String?
  smtpPort          Int?
  smtpUser          String?
  smtpPass          String?
  smtpFromName      String?
  smtpFromEmail     String?
  smtpSecure        Boolean  @default(true)

  // Smartlead
  smartleadApiKey   String?
  smartleadDefaultCampaignId String?
  smartleadWebhookSecret      String?  // 驗證 webhook 用

  // Apollo.io
  hunterApiKey      String?

  // Cal.com（會議追蹤）
  calComApiKey      String?
  calComWebhookSecret String?

  // Stripe（計費）
  stripeSecretKey        String?
  stripeWebhookSecret    String?
  stripeMeteredPriceId   String?  // 依發信量計費的 price ID

  // ===== 多 AI 提供者設定（fallback 機制）=====
  // 當 Z.ai 限流時，自動切換到這些提供者
  openaiApiKey      String?  // OpenAI GPT-4o / GPT-4o-mini
  openaiModel       String?  @default("gpt-4o-mini")
  anthropicApiKey   String?  // Claude 3.5 Sonnet
  anthropicModel    String?  @default("claude-3-5-sonnet-20241022")
  geminiApiKey      String?  // Google Gemini
  geminiModel       String?  @default("gemini-2.5-flash")
  // Groq (OpenAI-compatible, free + very fast Llama 3.3 70B)
  groqApiKey        String?  // Groq API key
  groqModel         String?  @default("llama-3.1-8b-instant")
  // web_search 替代方案
  tavilyApiKey      String?  // Tavily AI 搜尋
  // page_reader 替代方案
  jinaApiKey        String?  // Jina Reader
  firecrawlApiKey   String?  // Firecrawl
  // 提供者優先順序（逗號分隔）
  chatProviderOrder       String?  @default("groq,zai,gemini,openai,anthropic")
  searchProviderOrder     String?  @default("zai,tavily")
  pageReaderProviderOrder String?  @default("zai,jina,firecrawl")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ===== 服務介紹（每個租戶一筆） =====
model ServiceOffering {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  serviceName       String?
  description       String?
  targetIndustries  String?
  targetCompanySize String?
  targetLocation    String?
  keyBenefits        String?
  idealCustomerSignals String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ===== 開信追蹤事件（Smartlead webhook 寫入） =====
model EmailEvent {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  eventType     String   // sent | delivered | opened | replied | bounced | clicked
  eventTime     DateTime @default(now())
  rawPayload    String?  // 完整 webhook payload

  createdAt     DateTime @default(now())

  @@index([tenantId, leadId])
  @@index([tenantId, eventType])
  @@index([leadId, eventType])
}

// ===== 會議追蹤（Cal.com webhook 寫入） =====
model Meeting {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  source        String   @default("calcom")  // calcom | calendly | manual
  externalId    String?  // Cal.com 的 booking ID
  attendeeEmail String?
  attendeeName  String?
  eventTypeId   String?
  startTime     DateTime
  endTime       DateTime
  status        String   @default("scheduled")  // scheduled | completed | cancelled
  rawPayload    String?

  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, leadId])
}

// ===== 用量事件（給 Stripe metered billing 用） =====
model UsageEvent {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type          String   // email_sent | lead_added | email_enriched
  leadId        String?
  metadata      String?  // JSON
  stripeUsageRecorded Boolean @default(false)  // 是否已上報到 Stripe
  recordedAt    DateTime?

  createdAt     DateTime @default(now())

  @@index([tenantId, type, stripeUsageRecorded])
  @@index([tenantId, createdAt])
}

// ===== Credit Ledger (Atomic credit transactions) =====
model CreditLog {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type          String   // DEBIT | CREDIT_RESET | ADD_ON_PURCHASE
  amount        Int      // positive for credit, negative for debit
  balanceAfter  Int
  description   String
  leadId        String?  // related lead if applicable
  stripePaymentId String? // for add-on purchases

  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, type])
}

// ===== Mailbox (OAuth-connected email accounts for inbox rotation) =====
model Mailbox {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider      String   // google | microsoft | smtp
  emailAddress  String
  // OAuth tokens (encrypted in production)
  accessToken   String?
  refreshToken  String?
  tokenExpiresAt DateTime?
  // SMTP fallback
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String?
  smtpSecure    Boolean  @default(true)
  fromName      String?

  status        String   @default("active") // active | paused | disconnected
  dailySentCount Int     @default(0)
  lastSentAt    DateTime?
  dailyLimit    Int      @default(50)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
}

// ===== Prospect evaluation cache =====
// Redesigned engine stage-1/stage-2 results per (domain, service) pair —
// re-runs and cross-tenant repeat candidates skip the LLM entirely.
model ProspectEvalCache {
  id          String   @id @default(cuid())
  domain      String
  serviceHash String
  // JSON: { type, candidate } — classification verdict + full evaluation
  verdict     String
  createdAt   DateTime @default(now())

  @@unique([domain, serviceHash])
  @@index([serviceHash, createdAt])
}
